{
  "info": {
    "name": "Manage Cars API",
    "description": "API requests for Manage Cars Full Stack App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Test User\",\n  \"correo\": \"test@user.com\",\n  \"contrasena\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8085/api/v1/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8085",
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@admin.com\",\n  \"contrasena\": \"admin123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8085/api/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8085",
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Car Service",
      "item": [
        {
          "name": "Get Mis Autos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8081/api/v1/autos/mis-autos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "v1", "autos", "mis-autos"]
            }
          }
        },
        {
          "name": "Create Auto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"anio\": \"2023\",\n  \"placa\": \"XYZ-987\",\n  \"color\": \"Rojo\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/v1/autos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "v1", "autos"]
            }
          }
        },
        {
          "name": "Precargar 10 Autos",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8081/api/v1/autos/precargar",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "v1", "autos", "precargar"]
            }
          }
        },
        {
          "name": "Get Marcas (Catálogo)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8081/api/v1/catalogo/marcas",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "v1", "catalogo", "marcas"]
            }
          }
        }
      ]
    }
  ]
}
